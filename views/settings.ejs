<%- include('partials/header', { title: 'Monitoring Settings' }) %>
<% if (message) { %><div class="notice"><%= message %></div><% } %>
<section class="panel">
  <h2>Local Monitoring</h2>
  <p>Adjust device monitoring without the advanced administrator login. Network, email, HTTPS, WordPress and security settings are kept under Advanced Settings.</p>
  <form method="post" action="/settings" class="settings-form">
    <label>Check Interval Seconds<input name="check_interval_seconds" type="number" min="1" value="<%= settings.check_interval_seconds || '10' %>"></label>
    <p class="description">How often monitored devices are checked. Recommended: 10 seconds. Restart the service after changing.</p>
    <label>Fail Threshold<input name="fail_threshold" type="number" min="1" value="<%= settings.fail_threshold || '3' %>"></label>
    <p class="description">Number of consecutive failed checks before an offline alert.</p>
    <label>Recovery Threshold<input name="recovery_threshold" type="number" min="1" value="<%= settings.recovery_threshold || '2' %>"></label>
    <p class="description">Number of successful checks required before sending a recovery alert.</p>
    <button class="button" type="submit">Save Monitoring Settings</button>
  </form>
</section>
<section class="panel">
  <h2>Advanced Configuration</h2>
  <p>Administrator login required for network, SMTP alerts, WordPress reporting, HTTPS and security diagnostics.</p>
  <a class="button" href="/settings/advanced">Open Advanced Settings</a>
</section>
